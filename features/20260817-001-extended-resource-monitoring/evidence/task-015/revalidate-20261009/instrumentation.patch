--- a/ResourceRunner/Task015Probe.swift
+++ b/ResourceRunner/Task015Probe.swift
@@ -0,0 +1,26 @@
+import Foundation
+
+// 임시 진단 복사본만 사용합니다. 수집 수락 수는 저장소 반영 시점에 센 값입니다.
+nonisolated enum Task015Probe {
+    private final class State: @unchecked Sendable {
+        let lock = NSLock()
+        var counts: [String: Int] = [:]
+    }
+    private static let state = State()
+
+    static func emit(_ event: String) {
+        guard ProcessInfo.processInfo.arguments.contains("--task015-probe") else { return }
+        let line = "TASK015 wall=\(Date().ISO8601Format()) \(event)\n"
+        FileHandle.standardOutput.write(Data(line.utf8))
+    }
+
+    static func accepted(_ axis: String, epoch: Int, detail: String = "") {
+        guard ProcessInfo.processInfo.arguments.contains("--task015-probe") else { return }
+        let count = state.lock.withLock { () -> Int in
+            let next = (state.counts[axis] ?? 0) + 1
+            state.counts[axis] = next
+            return next
+        }
+        emit("accepted axis=\(axis) count=\(count) epoch=\(epoch) \(detail)")
+    }
+}
