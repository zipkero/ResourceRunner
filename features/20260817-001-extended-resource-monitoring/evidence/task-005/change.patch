+
+        let failureReader = ScriptedNetworkCounterReader([
+            .success(snapshot(0, [(target, raw(rx: 100, tx: 100))])),
+            .success(snapshot(1, [(target, raw(rx: 110, tx: 110))])),
+            .failure(.malformed("injected")),
