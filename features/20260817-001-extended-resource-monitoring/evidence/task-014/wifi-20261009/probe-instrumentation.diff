@@ -0,0 +1,9 @@
+import Foundation
+
+// 임시 실기기 관찰: 한 줄에 하나의 관측을 남기며 제품 계산에는 관여하지 않습니다.
+nonisolated enum Task014Probe {
+    static func emit(_ event: String) {
+        let line = "TASK014 wall=\(Date().ISO8601Format()) \(event)\n"
+        FileHandle.standardOutput.write(Data(line.utf8))
+    }
+}
